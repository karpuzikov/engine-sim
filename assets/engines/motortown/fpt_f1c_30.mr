            .connect_wire(wires.wire3, (180.0 / 720.0) * cycle)
            .connect_wire(wires.wire4, (360.0 / 720.0) * cycle)
            .connect_wire(wires.wire2, (540.0 / 720.0) * cycle);
}  // firing order ESTIMATE

