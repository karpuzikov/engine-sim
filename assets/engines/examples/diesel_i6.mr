import "engine_sim.mr"

// Example: a 12.8 L inline-six truck diesel (131 x 158 mm, like a Volvo D13), naturally aspirated.
// Fuel is injected into the cylinders and lights by compression; the pedal meters fuel.

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

label cycle(2 * 360 * units.deg)

public node diesel_i6 {
    alias output __out: engine;

    wires wires()

    engine engine(
        name: "Diesel I6 12.8 L (example)",
        starter_torque: 600 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 2100 * units.rpm,
        fuel: diesel_fuel(),
        simulation_frequency: 20000
    )

    label stroke(158 * units.mm)
    label bore(131 * units.mm)
    label rod_length(260 * units.mm)
    label compression_height(80 * units.mm)
    label compression_ratio(17.5)

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 60 * units.kg,
        mass: 100 * units.kg,
        friction_torque: 60 * units.lb_ft,
        moment_of_inertia: 3.0,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg
    )

    // Each journal at its cylinder's firing angle (firing order 1-5-3-6-2-4).
    rod_journal rj1(angle: 0 * units.deg)
    rod_journal rj2(angle: 480 * units.deg)
    rod_journal rj3(angle: 240 * units.deg)
    rod_journal rj4(angle: 600 * units.deg)
    rod_journal rj5(angle: 120 * units.deg)
    rod_journal rj6(angle: 360 * units.deg)
    c0.add_rod_journal(rj1).add_rod_journal(rj2).add_rod_journal(rj3).add_rod_journal(rj4).add_rod_journal(rj5).add_rod_journal(rj6)

    piston_parameters piston_params(
        mass: 4.0 * units.kg,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 4.5 * units.kg,
        moment_of_inertia: rod_moment_of_inertia(mass: 4.5 * units.kg, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    intake intake(
        plenum_volume: 10.0 * units.L,
        plenum_cross_section_area: 100.0 * units.cm2,
        intake_flow_rate: k_carb(3000.0),
        runner_flow_rate: k_carb(600.0),
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(2000.0),
        primary_tube_length: 20.0 * units.inch,
        primary_flow_rate: k_carb(600.0),
        velocity_decay: 1.0,
        volume: 200.0 * units.L
    )
    exhaust_system exhaust0(es_params, audio_volume: 1.0, impulse_response: ir_lib.default_0)

    cylinder_bank b0(bank_params, angle: 0)
    b0
        .add_cylinder(piston: piston(piston_params, blowby: 0), connecting_rod: connecting_rod(cr_params), rod_journal: rj1, intake: intake, exhaust_system: exhaust0, ignition_wire: wires.wire1)
        .add_cylinder(piston: piston(piston_params, blowby: 0), connecting_rod: connecting_rod(cr_params), rod_journal: rj2, intake: intake, exhaust_system: exhaust0, ignition_wire: wires.wire2)
        .add_cylinder(piston: piston(piston_params, blowby: 0), connecting_rod: connecting_rod(cr_params), rod_journal: rj3, intake: intake, exhaust_system: exhaust0, ignition_wire: wires.wire3)
        .add_cylinder(piston: piston(piston_params, blowby: 0), connecting_rod: connecting_rod(cr_params), rod_journal: rj4, intake: intake, exhaust_system: exhaust0, ignition_wire: wires.wire4)
        .add_cylinder(piston: piston(piston_params, blowby: 0), connecting_rod: connecting_rod(cr_params), rod_journal: rj5, intake: intake, exhaust_system: exhaust0, ignition_wire: wires.wire5)
        .add_cylinder(piston: piston(piston_params, blowby: 0), connecting_rod: connecting_rod(cr_params), rod_journal: rj6, intake: intake, exhaust_system: exhaust0, ignition_wire: wires.wire6)
    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    harmonic_cam_lobe lobe(duration_at_50_thou: 200 * units.deg, gamma: 1.0, lift: 500 * units.thou, steps: 100)
    camshaft_parameters cam_params(advance: 0 * units.deg, base_radius: 1.0 * units.inch)
    camshaft intake_cam(cam_params, lobe_profile: lobe)
    camshaft exhaust_cam(cam_params, lobe_profile: lobe)
    label lobe_separation(112 * units.deg)
    label rot360(360 * units.deg)
    // Firing order 1-5-3-6-2-4, one firing every 120 degrees.
    intake_cam
        .add_lobe(rot360 + lobe_separation + 0 * units.deg)
        .add_lobe(rot360 + lobe_separation + 480 * units.deg)
        .add_lobe(rot360 + lobe_separation + 240 * units.deg)
        .add_lobe(rot360 + lobe_separation + 600 * units.deg)
        .add_lobe(rot360 + lobe_separation + 120 * units.deg)
        .add_lobe(rot360 + lobe_separation + 360 * units.deg)
    exhaust_cam
        .add_lobe(rot360 - lobe_separation + 0 * units.deg)
        .add_lobe(rot360 - lobe_separation + 480 * units.deg)
        .add_lobe(rot360 - lobe_separation + 240 * units.deg)
        .add_lobe(rot360 - lobe_separation + 600 * units.deg)
        .add_lobe(rot360 - lobe_separation + 120 * units.deg)
        .add_lobe(rot360 - lobe_separation + 360 * units.deg)

    b0.set_cylinder_head(
        generic_small_engine_head(
            chamber_volume: (constants.pi / 4 * bore * bore * stroke) / (compression_ratio - 1),
            flow_attenuation: 2.6,
            intake_camshaft: intake_cam,
            exhaust_camshaft: exhaust_cam
        )
    )

    // Start of injection before top dead center.
    function injection_timing(500 * units.rpm)
    injection_timing
        .add_sample(0 * units.rpm, 4 * units.deg)
        .add_sample(500 * units.rpm, 4 * units.deg)
        .add_sample(1000 * units.rpm, 7 * units.deg)
        .add_sample(1500 * units.rpm, 10 * units.deg)
        .add_sample(2000 * units.rpm, 12 * units.deg)
        .add_sample(2500 * units.rpm, 12 * units.deg)

    engine.add_ignition_module(
        diesel_injection_pump(
            timing_curve: injection_timing,
            max_fuel_per_injection: 200 * units.g / 1000,
            idle_speed: 600 * units.rpm,
            governed_speed: 1900 * units.rpm
        )
            .connect_wire(wires.wire1, (0.0 / 6.0) * cycle)
            .connect_wire(wires.wire5, (1.0 / 6.0) * cycle)
            .connect_wire(wires.wire3, (2.0 / 6.0) * cycle)
            .connect_wire(wires.wire6, (3.0 / 6.0) * cycle)
            .connect_wire(wires.wire2, (4.0 / 6.0) * cycle)
            .connect_wire(wires.wire4, (5.0 / 6.0) * cycle)
    )
}

private node diesel_i6_vehicle {
    alias output __out:
        vehicle(mass: 15000 * units.kg, drag_coefficient: 0.6, cross_sectional_area: (100 * units.inch) * (120 * units.inch),
                diff_ratio: 3.4, tire_radius: 20 * units.inch, rolling_resistance: 0.006 * 15000 * units.kg * 9.81);
}

private node diesel_i6_transmission {
    alias output __out:
        transmission(max_clutch_torque: 2500 * units.lb_ft)
        .add_gear(14.9).add_gear(11.7).add_gear(9.0).add_gear(7.1).add_gear(5.5).add_gear(4.3).add_gear(3.4).add_gear(2.6).add_gear(2.0).add_gear(1.6).add_gear(1.3).add_gear(1.0);
}

public node main {
    set_engine(diesel_i6())
    set_vehicle(diesel_i6_vehicle())
    set_transmission(diesel_i6_transmission())
}
